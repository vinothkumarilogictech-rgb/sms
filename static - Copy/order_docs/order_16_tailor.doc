<html><head><meta charset='utf-8'><style>@page Section1{size:72.1mm 210mm;margin:0mm;mso-page-orientation:portrait;}div.Section1{page:Section1;}body{font-family:'Nirmala UI','Nirmala UI','Latha','Vijaya',sans-serif;font-size:11pt;margin:0;letter-spacing:0;}.head{width:calc(100% - 8px);max-width:calc(100% - 8px);border-collapse:separate;table-layout:auto;border-spacing:3px 0;margin:0 4px 1mm 4px;box-sizing:border-box;}.head td{padding:0 1px;vertical-align:middle;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.head td:nth-child(2){text-align:center;}.head td:nth-child(3){text-align:right;padding-right:8px;}.rule{height:0;border-top:1px dashed #1f5f9c;margin:0.4mm 4px 0.8mm 4px;box-sizing:border-box;}.row2{width:calc(100% - 8px);max-width:calc(100% - 8px);border-collapse:separate;table-layout:auto;border-spacing:3px 0;margin:0 4px 0.4mm 4px;box-sizing:border-box;}.row2 td{padding:0 1px;vertical-align:middle;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.row2 td:first-child{text-align:left;}.row2 td:last-child{text-align:right;padding-right:8px;}.kind{margin:0 0 0.5mm 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.mgrid{width:100%;border-collapse:collapse;table-layout:fixed;margin:0 0 1.2mm 0;}.mgrid .lbl{font-size:9pt;text-align:center;padding:0 0.4mm;white-space:nowrap;}.mgrid .val{font-size:10.5pt;text-align:center;padding:0 0.4mm;white-space:nowrap;}.mgrid-thermal{width:calc(100% - 8px);max-width:calc(100% - 8px);border-collapse:separate;table-layout:auto;border-spacing:3px 0;margin:0.4mm 4px 1.0mm 4px;box-sizing:border-box;}.mgrid-thermal td{width:1%;padding:0 2px;vertical-align:top;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.mgrid-thermal .name{display:block;font-size:9pt;font-weight:700;line-height:1.12;white-space:nowrap;word-break:normal;overflow-wrap:normal;overflow:hidden;text-overflow:ellipsis;}.mgrid-thermal .value{display:block;font-size:10.5pt;font-weight:700;line-height:1.22;margin-top:4px;white-space:normal;overflow:hidden;text-overflow:ellipsis;}.section{margin:1.2mm 0 0.2mm 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}p{margin:0;line-height:1.12;}@media print{@page{margin:0!important;}@page Section1{size:72.1mm 210mm;margin:0;mso-page-orientation:portrait;}html,body{margin:0!important;padding:0!important;}.Section1.thermal-vertical{position:relative;display:block;top:0.2mm;left:-1mm;margin:0;padding:0;transform-origin:top left;transform:rotate(90deg) translateY(-72.1mm);width:210mm;height:72.1mm;overflow:hidden;page-break-inside:avoid;break-inside:avoid-page;}.head,.row2,.mgrid-thermal{width:calc(100% - 8px)!important;max-width:calc(100% - 8px)!important;margin-left:4px!important;margin-right:4px!important;box-sizing:border-box!important;}.rule{margin-left:4px!important;margin-right:4px!important;}.thermal-slip{margin-top:0!important;padding-top:0!important;padding-bottom:0!important;height:210mm!important;max-height:210mm!important;box-sizing:border-box!important;overflow:hidden!important;page-break-after:always;break-after:page;}.thermal-slip:last-child{page-break-after:auto;break-after:auto;}}</style></head><body><div class='Section1 thermal-vertical thermal-slip'><table class='head'><tr><td><b>INVOICE&nbsp;&nbsp;NO:</b>&nbsp;&nbsp;000007\1</td><td><b>ORDER&nbsp;&nbsp;DATE:</b>&nbsp;&nbsp;05-03-2026</td><td><b>DELIVERY&nbsp;&nbsp;DATE:</b>&nbsp;&nbsp;09-03-2026</td></tr></table><div class='rule'></div><table class='row2'><tr><td><b>Items</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:&nbsp;&nbsp;Shirt - Full Hand</td><td><b>Qty:</b>&nbsp;&nbsp;1</td></tr></table><p class='section'><b>Measurements</b></p><p class='kind'>&nbsp;</p><table class='mgrid-thermal'><tr><td><span class='name'>கை அளவு</span><span class='value'>fdsfsd</span></td><td><span class='name'>M அளவு</span><span class='value'>sdf</span></td><td><span class='name'>உயரம்</span><span class='value'>sdfsd</span></td><td><span class='name'>கை நீளம்</span><sp
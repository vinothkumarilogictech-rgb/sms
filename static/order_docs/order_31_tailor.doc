<html><head><meta charset='utf-8'><style>@page Section1{size:72mm 220.0mm;margin:2mm;mso-page-orientation:portrait;}div.Section1{page:Section1;}body{font-family:'Latha','Nirmala UI','Latha','Vijaya',sans-serif;font-size:13pt;margin:0;letter-spacing:0;}.head{width:calc(100% - 20px);max-width:calc(100% - 20px);border-collapse:separate;table-layout:auto;border-spacing:10px 0;margin:0 10px 2mm 10px;box-sizing:border-box;}.head td{padding:0 2px;vertical-align:middle;white-space:nowrap;}.head td:nth-child(2){text-align:center;}.head td:nth-child(3){text-align:right;padding-right:8px;}.rule{height:0;border-top:1px dashed #1f5f9c;margin:0.8mm 10px 1.2mm 10px;box-sizing:border-box;}.row2{width:calc(100% - 20px);max-width:calc(100% - 20px);border-collapse:separate;table-layout:auto;border-spacing:10px 0;margin:0 10px;box-sizing:border-box;}.row2 td{padding:0 2px;vertical-align:middle;white-space:nowrap;}.row2 td:first-child{text-align:left;}.row2 td:last-child{text-align:right;padding-right:8px;}.kind{margin:0 0 0.5mm 0;}.mgrid{width:100%;border-collapse:collapse;table-layout:fixed;margin:0 0 1.2mm 0;}.mgrid .lbl{font-size:9pt;text-align:center;padding:0 0.4mm;white-space:nowrap;}.mgrid .val{font-size:15pt;text-align:center;padding:0 0.4mm;white-space:nowrap;}.mgrid-thermal{width:calc(100% - 20px);max-width:calc(100% - 20px);border-collapse:separate;table-layout:auto;border-spacing:10px 0;margin:0.35mm 10px 0.7mm 10px;box-sizing:border-box;}.mgrid-thermal td{width:1%;padding:0 2px;vertical-align:top;text-align:center;white-space:nowrap;}.mgrid-thermal .name{display:block;font-size:9pt;font-weight:700;line-height:1.0;white-space:nowrap;word-break:normal;overflow-wrap:normal;}.mgrid-thermal .value{display:block;font-size:15pt;font-weight:700;line-height:1.0;margin-top:10px;white-space:nowrap;}.section{margin:0;}p{margin:0;line-height:1.0;}@media print{@page Section1{size:72mm 220.0mm;margin:0;mso-page-orientation:portrait;}html,body{margin:0!important;padding:0!important;width:
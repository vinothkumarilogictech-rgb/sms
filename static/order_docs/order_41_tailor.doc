<html><head><meta charset='utf-8'><style>@page Section1{size:72.1mm 210mm;margin:0mm;mso-page-orientation:portrait;}div.Section1{page:Section1;}body{font-family:'Latha','Nirmala UI','Latha','Vijaya',sans-serif;font-size:11pt;margin:0;letter-spacing:0;}.head{width:calc(100% - 8px);max-width:calc(100% - 8px);border-collapse:separate;table-layout:auto;border-spacing:3px 0;margin:0 4px 1mm 4px;box-sizing:border-box;}.head td{padding:0 1px;vertical-align:middle;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.head td:nth-child(2){text-align:center;}.head td:nth-child(3){text-align:right;padding-right:8px;}.rule{height:0;border-top:1px dashed #1f5f9c;margin:0.4mm 4px 0.8mm 4px;box-sizing:border-box;}.row2{width:calc(100% - 8px);max-width:calc(100% - 8px);border-collapse:separate;table-layout:auto;border-spacing:3px 0;margin:0 4px 0.4mm 4px;box-sizing:border-box;}.row2 td{padding:0 1px;vertical-align:middle;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.row2 td:first-child{text-align:left;}.row2 td:last-child{text-align:right;padding-right:8px;}.kind{margin:0 0 0.5mm 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.mgrid{width:100%;border-collapse:collapse;table-layout:fixed;margin:0 0 1.2mm 0;}.mgrid .lbl{font-size:9pt;text-align:center;padding:0 0.4mm;white-space:nowrap;}.mgrid .val{font-size:10.5pt;text-align:center;padding:0 0.4mm;white-space:nowrap;}.mgrid-thermal{width:calc(100% - 8px);max-width:calc(100% - 8px);border-collapse:separate;table-layout:auto;border-spacing:3px 0;margin:0.4mm 4px 1.0mm 4px;box-sizing:border-box;}.mgrid-thermal td{width:1%;padding:0 2px;vertical-align:top;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.mgrid-thermal .name{display:block;font-size:9pt;font-weight:700;line-height:1.12;white-space:nowrap;word-break:normal;overflow-wrap:normal;overflow:hidden;text-overflow:ellipsis;}.mgrid-thermal .value{display:block;font-size:10.5pt;font-weight:700;line-height:1.22;margin-top:4px;white-space:normal;overflow:hidden;text-overflow:ellipsis;}.section{margin:1.2mm 0 0.2mm 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.section-wrap{margin:1.2mm 0 0.2mm 0;white-space:normal;overflow:visible;word-break:break-word;}.kv{width:calc(100% - 8px);max-width:calc(100% - 8px);border-collapse:separate;table-layout:fixed;border-spacing:0;margin:1.2mm 4px 0.2mm 4px;}.kv td{vertical-align:top;padding:0 1px;}.kv .k{width:22mm;font-weight:700;white-space:nowrap;}.kv .c{width:4mm;text-align:center;}.kv .v{white-space:normal;word-break:break-word;}p{margin:0;line-height:1.12;}@media print{@page{margin:0!important;}@page Section1{size:72.1mm 210mm;margin:0;mso-page-orientation:portrait;}html,body{margin:0!important;padding:0!important;width:72.1mm;min-height:210mm;overflow:visible;}.Section1.thermal-vertical{position:relative;display:block;top:0;left:0;margin:0;padding:0;transform-origin:top left;transform:rotate(90deg) translateY(-72.1mm);width:210mm;height:72.1mm;overflow:hidden;page-break-inside:avoid;break-inside:avoid-page;}.head,.row2,.mgrid-thermal{width:100%!important;max-width:100%!important;margin-left:0!important;margin-right:0!important;border-spacing:0!important;box-sizing:border-box!important;}.rule{margin-left:0!important;margin-right:0!important;}.thermal-slip{margin-top:0!important;padding-top:0!important;padding-bottom:0!important;height:210mm!important;max-height:210mm!important;box-sizing:border-box!important;overflow:hidden!important;page-break-after:always;break-after:page;}.thermal-slip + .thermal-slip{page-break-before:always;break-before:page;}.thermal-slip:last-child{page-break-after:auto;break-after:auto;}}</style></head><body><div class='Section1 thermal-vertical thermal-slip'><table class='head'><tr><td><b>INVOICE&nbsp;&nbsp;NO:</b>&nbsp;&nbsp;000006\4</td><td><b>ORDER&nbsp;&nbsp;DATE:</b>&nbsp;&nbsp;13-03-2026</td><td><b>DELIVERY&nbsp;&nbsp;DATE:</b>&nbsp;&nbsp;17-03-2026</td></tr></table><div class='rule'></div><table class='row2'><tr><td><b>Items</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:&nbsp;&nbsp;Shirt - Full Hand</td><td><b>Qty:</b>&nbsp;&nbsp;1</td></tr></table><p class='section'><b>Measurements</b></p><p class='kind'>&nbsp;</p><table class='mgrid-thermal'><tr><td><span class='name'>உயரம்</span><span class='value'>1</span></td><td><span class='name'>பாடி</span><span class='value'>1 1/2</span></td><td><span class='name'>சோல்டர்</span><span class='value'>1 1/2</span></td><td><span class='name'>கை நீளம்</span><span class='value'>1 1/4</span></td><td><span class='name'>கை லூஸ்</span><span class='value'>1 1/4</span></td><td><span class='name'>கப்</span><span class='value'>1 3/4</span></td><td><span class='name'>காலர்</span><span class='value'>1 3/4</span></td><td><span class='name'>சைட் லூஸ்</span><span class='value'>1 1/4</span></td><td><span class='name'>M லூஸ்</span><span class='value'>1 3/4</span></td></tr></table><table class='kv'><tr><td class='k'>Requirements</td><td class='c'>:</td><td class='v'><div>Button</div></td></tr></table><table class='kv'><tr><td class='k'>Notes</td><td class='c'>:</td><td class='v'><div>adjfhlaskdjfhakldsjfhalkdjfhaslkdjfhaskldjfhakldsjfhaslkdjfhaskdjfhaskldjfhaslkdjfhaskdjfhaskldfjhaldskfjh</div></td></tr></table></div></body></html>